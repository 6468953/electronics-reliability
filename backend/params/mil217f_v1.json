{
  "standard": "MIL-217F",
  "version_tag": "v1.0",
  "display_name": "MIL-HDBK-217F（美军可靠性预计手册，Notice 2）",
  "source_ref": "MIL-HDBK-217F Notice 2 (1995) — Part Count 见 Sec.5~Sec.10 各类别表；Part Stress 见各类别详细模型",
  "disclaimer": "本参数库为【示例数据，仅供演示/学习】：绝对失效率量级取自公开标准与公开文献的典型范围，环境倍率与质量因子采用标准常用档位，但未逐格抄录原表数值，不可用于真实产品认证结论。正式使用请以标准原表替换 params 目录下同名 JSON（结构不变，引擎无需改代码）。",
  "notes": {
    "lambda_g": "基础失效率，单位 FIT（每 10^9 小时的失效次数），基准条件：环境 GB（地面固定）、质量等级 commercial、25~40°C。实际 λ_g(类别,环境) = lambda_g × environments[环境].mult。",
    "env_mult": "环境倍率，等效于 π_E。以 GB=1.0 为基准，按 MIL-HDBK-217F π_E 的常用档位取值（示例）。",
    "pi_q": "质量因子。1.0 = 基准质量；数值越大表示该质量等级的器件失效率越高。军品级 < 车规 < 工业 < 商用。",
    "parts_count": "零件计数法公式：λ_整机 = Σ(用量 × λ_g × π_Q)。此模式【不含温度修正】——这是标准定义（用于早期无详细应力信息的阶段），不是 bug。",
    "parts_stress": "零件应力法公式：λ_零件 = λ_b × π_T × π_V × π_S × π_Q × π_E。各类别实际参与的因子并不相同，由 family 决定；未提供应力数据时该因子取 1.0 并在追溯中标注 default。",
    "family": "因子族模板。同一族共享 π_T / π_V / π_S 的公式形式，类别只需覆盖差异项，避免每个类别重复抄写。",
    "mechanical": "非电子件（结构五金、线缆、辅料、包装）。MIL-HDBK-217F 与 Telcordia SR-332 都不覆盖这类零件，业界做法是另配 NSWC-11（机械件）或 NPRD（非电子件数据）模型。本系统未实现这两套标准，因此这些类目标记 is_standard=false，λ 值按 NPRD 量级取保守工程值，并在结果页与报告中单列为「非标准覆盖件」，不得作为定稿依据。",
    "ic_model": "注意：MIL-HDBK-217F 对集成电路的原式是 C1·π_T + C2·π_E 的双项模型；本实现统一用 Arrhenius 单指数近似（Ea 可配），这是【有意的简化】，差异在常温区通常 <2 倍。"
  },
  "engine_version": "1.0.0",
  "stress_lambda_factor": 0.8,
  "environments": {
    "GB": { "label": "地面固定 GB（室内/机柜，空调或通风良好）", "mult": 1.0 },
    "GF": { "label": "地面移动 GF（可搬动，非固定安装）", "mult": 2.0 },
    "GM": { "label": "地面便携（ handheld，频繁移动与跌落）", "mult": 4.0 },
    "MP": { "label": "车载（发动机舱外，振动+温循）", "mult": 5.0 },
    "NS": { "label": "舰船/船舶（盐雾+湿度）", "mult": 7.0 },
    "AIC": { "label": "机载有控（商用客机货舱/客舱）", "mult": 9.0 },
    "ARW": { "label": "机载无人（无人机，振动更严酷）", "mult": 15.0 },
    "SF": { "label": "航天（辐射+真空+大温循）", "mult": 23.0 },
    "C": { "label": "受控实验室/机房（空调环境）", "mult": 0.6 }
  },
  "quality_levels": {
    "commercial": { "label": "商用级（0~70°C，消费电子常见）", "pi_q": 3.0 },
    "industrial": { "label": "工业级（-40~85°C）", "pi_q": 2.0 },
    "automotive": { "label": "车规级（AEC-Q100/Q200）", "pi_q": 1.5 },
    "military": { "label": "军品级（MIL-PRF 筛选）", "pi_q": 1.0 }
  },
  "families": {
